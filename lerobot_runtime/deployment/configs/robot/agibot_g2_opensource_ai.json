{
  "_comment": [
    "16DOF LeRobot: publish 2.5Hz 이하. GDK arm_lead 는 보수적으로(현재 속도보다 빠르지 않게).",
    "AgiBot G2 관절과 카메라는 ROS가 아니다. 벤더 SDK(agibot_gdk)가 로봇",
    "로컬 공유메모리에서 읽어오므로, 이 config 로 도는 정책은 반드시 로봇 온보드에서",
    "source /home/agi/app/env.sh 를 거친 뒤 실행해야 한다.",
    "몸통·카메라 topic 문자열은 ROS 토픽이 아니라 어떤 GDK 호출을 쓰는지 적어둔 것이다.",
    "카메라는 gdk_camera_id 로 agibot_gdk.CameraType 멤버를 지정한다.",
    "손은 별도 명령 API가 없다. get_end_state로 읽고, 팔과 같은 joint_servo_control 프레임에 실어 보낸다.",
    "그리퍼 0/1 관측만 ROS 토픽이다. 손가락 명령은 정책 preset 이 joint_servo_control 로 나간다."
  ],
  "robot_name": "agibot_g2_opensource_ai",
  "adapter": "agibot_g2",
  "control": {
    "publish_hz": 20.0
  },
  "gdk": {
    "_comment": "target_timeout 0.4s; 만료 시 동일 목표 re-stamp(keepalive)로 slew 유지. direct_targets=false → motion_speed(arm_lead).",
    "state_poll_hz": 50.0,
    "command_hz": 100.0,
    "camera_poll_hz": 30.0,
    "control_period": 0.02,
    "enable_low_latency": false,
    "settle_sec": 2.0,
    "camera_warmup_sec": 2.0,
    "camera_timeout_ms": 1000.0,
    "joint_limit_margin_rad": 0.03,
    "state_stale_timeout_sec": 0.1,
    "target_timeout_sec": 0.4,
    "direct_targets": false,
    "arm_lead_rad": 0.02,
    "waist_lead_rad": 0.02,
    "head_velocity_rad_s": 1.5,
    "finger_velocity_rad_s": 4.0
  },
  "qos": {
    "_comment": "GDK 는 DDS QoS 를 쓰지 않는다. 공용 스키마가 요구해서 남겨둔 자리다.",
    "publisher": {
      "reliability": "RELIABLE",
      "history": "KEEP_LAST",
      "depth": 10,
      "durability": "VOLATILE"
    },
    "subscriber": {
      "reliability": "BEST_EFFORT",
      "history": "KEEP_LAST",
      "depth": 10,
      "durability": "VOLATILE"
    }
  },
  "pd_params": {
    "head": {
      "kp": 20.0,
      "kd": 2.0
    },
    "arm": {
      "kp": 20.0,
      "kd": 2.0
    }
  },
  "topics": {
    "states": {
      "head": {
        "enabled": true,
        "topic": "gdk://get_joint_states",
        "message_type": "agibot_gdk/JointStates"
      },
      "arm": {
        "enabled": true,
        "topic": "gdk://get_joint_states",
        "message_type": "agibot_gdk/JointStates"
      },
      "hand": {
        "enabled": true,
        "topic": "gdk://get_end_state",
        "message_type": "agibot_gdk/EndState"
      },
      "left_hand": {
        "enabled": false,
        "topic": null,
        "message_type": null
      },
      "right_hand": {
        "enabled": false,
        "topic": null,
        "message_type": null
      },
      "left_gripper": {
        "enabled": true,
        "topic": "/gripper/left/grip",
        "message_type": "std_msgs/Int32"
      },
      "right_gripper": {
        "enabled": true,
        "topic": "/gripper/right/grip",
        "message_type": "std_msgs/Int32"
      }
    },
    "commands": {
      "head": {
        "enabled": true,
        "topic": "gdk://move_head_joint_servo",
        "message_type": "agibot_gdk/HeadJointServo"
      },
      "arm": {
        "enabled": true,
        "topic": "gdk://joint_servo_control",
        "message_type": "agibot_gdk/JointServoControlReq"
      },
      "hand": {
        "enabled": false,
        "topic": null,
        "message_type": null
      },
      "left_hand": {
        "enabled": false,
        "topic": null,
        "message_type": null
      },
      "right_hand": {
        "enabled": false,
        "topic": null,
        "message_type": null
      },
      "left_gripper": {
        "enabled": false,
        "topic": null,
        "message_type": null
      },
      "right_gripper": {
        "enabled": false,
        "topic": null,
        "message_type": null
      }
    },
    "cameras": {
      "CAMERA_HEAD": {
        "enabled": true,
        "topic": "gdk://kHeadColor",
        "message_type": "agibot_gdk/CameraImage",
        "gdk_camera_id": "kHeadColor",
        "source_shape": [400, 640, 3]
      },
      "CAMERA_HAND_LEFT": {
        "enabled": true,
        "topic": "gdk://kHandLeftColor",
        "message_type": "agibot_gdk/CameraImage",
        "gdk_camera_id": "kHandLeftColor",
        "source_shape": [1056, 1280, 3]
      },
      "CAMERA_HAND_RIGHT": {
        "enabled": true,
        "topic": "gdk://kHandRightColor",
        "message_type": "agibot_gdk/CameraImage",
        "gdk_camera_id": "kHandRightColor",
        "source_shape": [1056, 1280, 3]
      },
      "CAMERA_HEAD_DEPTH": {
        "enabled": true,
        "topic": "gdk://kHeadDepth",
        "message_type": "agibot_gdk/CameraImage",
        "gdk_camera_id": "kHeadDepth",
        "source_shape": [400, 640, 1]
      }
    }
  },
